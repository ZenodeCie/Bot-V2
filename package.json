{
  "name": "zenode-vm-host",
  "version": "1.0.0",
  "description": "ZenodeBots VM host agent — orchestrates N Discord bot processes via PM2 and talks to dfb-vm-core.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/host/index.js",
    "start:bot": "node dist/bot/index.js",
    "dev": "tsc --watch",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop zenode-vm-host",
    "pm2:logs": "pm2 logs zenode-vm-host"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.9.1",
    "ws": "^8.18.3"
  }
}
