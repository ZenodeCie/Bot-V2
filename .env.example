# ============================================================================
#  ZenodeBots — VM Host (Bot Worker)  ·  Fichier d'EXEMPLE (sans secret)
# ============================================================================
#  Rôle : sert de modèle à copier. Aucun secret ci-dessous.
#  Copiez-le puis renseignez vos vraies valeurs :
#      cp .env.example .env       (Linux / macOS)
#      copy .env.example .env     (Windows PowerShell)
#
#  L'explication détaillée de chaque variable est dans README.md.
# ============================================================================


# ----------------------------------------------------------------------------
#  A) CONNEXION ENTRE CETTE VM (Worker/Bot) ET LA VM CORE
# ----------------------------------------------------------------------------
#  Le Core = le "cerveau" (distribue les bots, envoie les ordres).
#  Cette VM (Worker) = le "bras" (héberge et lance les bots Discord).

# URL de l'API REST du Core. OBLIGATOIRE.   Ex: http://10.0.0.5:3000
CORE_API_URL=http://localhost:4000

# URL du WebSocket du Core (ordres en temps réel). OPTIONNEL (calculé si vide).
# CORE_WS_URL=ws://localhost:4000/ws

# Clé API qui authentifie cette VM auprès du Core. OBLIGATOIRE.
# Correspond à API_KEY_VM_BOTS_FREE / API_KEY_VM_BOTS_PREMIUM du Core.
API_KEY=REMPLACE_PAR_TA_CLE_API

# Identifiant UNIQUE de cette machine. OBLIGATOIRE.
# Convention : vm-freebots-01, vm-freebots-02, …  /  vm-bots-premium
VM_HOST=vm-freebots-01

# Type de VM. OPTIONNEL (défaut : vm-bots-free).
VM_TYPE=vm-bots-free


# ----------------------------------------------------------------------------
#  B) CHEMINS & COMPORTEMENT DU HOST (agent qui gère les bots)
# ----------------------------------------------------------------------------
# CONFIGS_DIR=./configs
# DATA_DIR=./data
# BOT_ENTRY=dist/bot/index.js
# REPO_ROOT=.
# AUTO_START_ASSIGNED=false
# HOST_HEALTH_PORT=9100


# ----------------------------------------------------------------------------
#  C) MODE "ALONE" / "STANDALONE" (UN bot, sans Core ni agent)
# ----------------------------------------------------------------------------
#  Variables utilisées uniquement en mode --alone / wb (sans le Core).

# Token Discord du bot. OBLIGATOIRE en mode alone.
BOT_TOKEN=REMPLACE_PAR_LE_TOKEN_DISCORD

# BOT_ID=bot00019
# BOT_NAME=BotDev
# PREFIX=!
# BOT_STATUS=En ligne
# BOT_COLOR=#5865F2
# MODULES=Base,Utilities
# SUPPORT_URL=https://votre-support.fr
# IDs admin/owner, séparés par des virgules.
# OWNER_ID=ID_DISCORD_OWNER
# STANDALONE=1


# ----------------------------------------------------------------------------
#  D) BASE DE DONNÉES MongoDB (partagée entre les bots) — OPTIONNELLE
# ----------------------------------------------------------------------------
# MONGODB_URI=mongodb://localhost:27017/bot-v2
# MONGODB_DB=znd
